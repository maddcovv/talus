{
  "$description": "Talus global tokens. Same in every brand and color mode.",
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    }
  },
  "motion": {
    "$description": "Durations drop to 0ms under prefers-reduced-motion.",
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "{duration.fast}"
      },
      "base": {
        "$type": "duration",
        "$value": "{duration.base}"
      },
      "slow": {
        "$type": "duration",
        "$value": "{duration.slow}"
      }
    }
  },
  "z": {
    "base": {
      "$type": "number",
      "$value": 0
    },
    "sticky": {
      "$type": "number",
      "$value": 100
    },
    "dropdown": {
      "$type": "number",
      "$value": 200
    },
    "overlay": {
      "$type": "number",
      "$value": 300
    },
    "modal": {
      "$type": "number",
      "$value": 400
    },
    "popover": {
      "$type": "number",
      "$value": 500
    },
    "toast": {
      "$type": "number",
      "$value": 600
    }
  },
  "breakpoint": {
    "compact": {
      "$type": "dimension",
      "$value": "480px"
    },
    "medium": {
      "$type": "dimension",
      "$value": "768px"
    },
    "wide": {
      "$type": "dimension",
      "$value": "1080px"
    },
    "full": {
      "$type": "dimension",
      "$value": "1440px"
    }
  },
  "size": {
    "icon": {
      "sm": {
        "$type": "dimension",
        "$value": "16px"
      },
      "md": {
        "$type": "dimension",
        "$value": "20px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "24px"
      }
    },
    "touch-min": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$description": "Cards that lift on hover, sticky headers",
      "$value": [
        {
          "color": "{color.shadow.ambient}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$description": "Menus, popovers, select lists",
      "$value": [
        {
          "color": "{color.shadow.ambient}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "{color.shadow.key}",
          "offsetX": "0px",
          "offsetY": "6px",
          "blur": "16px",
          "spread": "-4px"
        }
      ]
    },
    "3": {
      "$type": "shadow",
      "$description": "Dialogs and drawers",
      "$value": [
        {
          "color": "{color.shadow.ambient}",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0px"
        },
        {
          "color": "{color.shadow.key}",
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "40px",
          "spread": "-8px"
        }
      ]
    }
  }
}