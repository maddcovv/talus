{
  "$description": "Talus consumer brand: type, size, density and shape. Pairs with a color mode.",
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "container": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    }
  },
  "control": {
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "36px"
      },
      "md": {
        "$type": "dimension",
        "$value": "48px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "52px"
      }
    }
  },
  "density": {
    "row": {
      "$type": "dimension",
      "$value": "56px"
    }
  },
  "border": {
    "width": {
      "control": {
        "$type": "dimension",
        "$value": "1px"
      },
      "feature": {
        "$type": "dimension",
        "$value": "2px"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": "{font.family.archivo}"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{font.family.plex-sans}"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "{font.family.plex-mono}"
      }
    },
    "weight": {
      "display": {
        "$type": "fontWeight",
        "$value": "{font.weight.extrabold}"
      }
    },
    "size": {
      "display": {
        "$type": "dimension",
        "$value": "{font.size.64}"
      },
      "h1": {
        "$type": "dimension",
        "$value": "{font.size.48}"
      },
      "h2": {
        "$type": "dimension",
        "$value": "{font.size.28}"
      },
      "h3": {
        "$type": "dimension",
        "$value": "{font.size.22}"
      },
      "body": {
        "$type": "dimension",
        "$value": "{font.size.16}"
      },
      "body-sm": {
        "$type": "dimension",
        "$value": "{font.size.14}"
      },
      "label": {
        "$type": "dimension",
        "$value": "{font.size.14}"
      },
      "caption": {
        "$type": "dimension",
        "$value": "{font.size.13}"
      }
    }
  },
  "focus": {
    "ring-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "ring-offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "shadow": {
    "feature": {
      "$type": "shadow",
      "$description": "Feature cards: the apply card, side cards, the postcard. Consumer is a printed offset in olive; enterprise stays soft.",
      "$value": [
        {
          "color": "{color.shadow.feature}",
          "offsetX": "6px",
          "offsetY": "6px",
          "blur": "0px",
          "spread": "0px"
        }
      ]
    }
  }
}